OPENAI_API_KEY=
DISCORD_WEBHOOK_URL=
# 1이면 Discord로 보내지 않고 로그만 출력 (기본값). 실제로 보내려면 DRY_RUN=0
DRY_RUN=1

# ── HITL 발송 승인 (docs/hitl-plan.md) — 비워 두면 승인 요청을 디스코드에 올리지 않는다
# 봇 토큰: Discord Developer Portal → 내 앱 → Bot → Reset Token (Message Content Intent 켜기)
DISCORD_BOT_TOKEN=
# 비공개 #검토 채널 ID와 내 사용자 ID (디스코드 설정 → 고급 → 개발자 모드 → 우클릭 'ID 복사')
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_REVIEWER_ID=
# 승인 대기 체크포인트 암호화 키 — 직접 만든다:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HITL_STATE_KEY=
